# Copier en `.env` puis adapter les valeurs.
# Ces variables sont consommées par docker-compose.yml (interpolation) et par
# l'application (préfixe APP_, cf. task_manager.infrastructure.config).

# --- Application ---
APP_APP_NAME="Task Manager"
APP_ECHO_SQL=false
# false par défaut (prod / Docker : Alembic). Mettre true en local pour un
# create_all au démarrage sans lancer les migrations.
APP_INIT_DB=false
API_PORT=8000
# Nombre de workers Gunicorn pour le service api (≈ 2×CPU + 1 en prod).
API_WORKERS=2
FRONTEND_PORT=5173

# --- PostgreSQL ---
POSTGRES_USER=task_manager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=task_manager
POSTGRES_PORT=5432

# --- PgBouncer (pooler devant PostgreSQL) ---
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=20

# URL consommée par l'application/CLI sur l'hôte (préfixe APP_). Assemblée par
# interpolation des composants ci-dessus (source unique de vérité) — pas besoin
# de recopier les identifiants. Les conteneurs, eux, reçoivent leur propre URL
# de docker-compose (host ``pgbouncer``, port 5432). ``prepared_statement_cache_size=0``
# est requis derrière PgBouncer en mode transaction.
APP_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${PGBOUNCER_PORT}/${POSTGRES_DB}?prepared_statement_cache_size=0

# --- RabbitMQ (broker Celery) ---
RABBITMQ_USER=task_manager
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# URL consommée par l'application/CLI sur l'hôte (préfixe APP_), assemblée par
# interpolation des composants ci-dessus (source unique de vérité). Le broker
# n'a pas d'utilisateur ``guest`` : les identifiants viennent des RABBITMQ_*.
APP_RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:${RABBITMQ_PORT}/

# --- Valkey (result backend Celery / cache) ---
VALKEY_PORT=6379
# URL consommée par l'application/CLI sur l'hôte (préfixe APP_). Les conteneurs
# reçoivent leur propre URL de docker-compose (host ``valkey``).
APP_REDIS_URL=redis://localhost:${VALKEY_PORT}/0

# --- RedisInsight (console d'inspection du cache) ---
REDISINSIGHT_PORT=5540
# Chiffre les secrets stockés par RedisInsight (sqlite local). Doit rester
# stable entre deux `up`, sinon les connexions enregistrées deviennent illisibles.
REDISINSIGHT_ENCRYPTION_KEY=change-me

# --- Mailpit (SMTP de test) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
